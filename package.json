{
  "name": "event-driven-notification-dispatcher",
  "version": "1.0.0",
  "description": "Lightweight asynchronous notification system using Express.js, Node.js, and SQLite.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "keywords": [
    "event-driven",
    "notification",
    "express",
    "sqlite",
    "async",
    "queue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  },
  "engines": {
    "node": "20.x"
  }
}
